# Set these in Vercel Environment Variables. Never commit real credentials.
NEXT_PUBLIC_SITE_URL=https://yorumi.parmeshwornapit.com.np
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase transaction pooler URL from the project's Connect dialog.
DATABASE_URL=
# Optional downloaded Supabase root certificate, with literal \n line breaks.
DATABASE_CA_CERT=
SUPABASE_STORAGE_BUCKET=yorumi-media
# The verified email allowed to initialize an administrator profile.
ADMIN_EMAIL=
